# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Microsoft Entra ID (Azure AD) app registration
# https://portal.azure.com -> App registrations -> New registration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Redirect URI (add in Azure portal under Authentication):
# http://localhost:4000/api/auth/microsoft/callback
AZURE_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback

# Required Graph delegated scopes (add under API permissions):
# - User.Read
# - OnlineMeetings.ReadWrite
# - offline_access

# Optional: app-only meeting creation (requires OnlineMeetings.ReadWrite.All
# + application access policy for this user in Teams admin)
AZURE_ORGANIZER_USER_ID=

# SQLite database file path
DATABASE_PATH=./data/skillx.db
